# Keep real values in a secret manager or deployment environment, never in this file.
AUTOPE_ENVIRONMENT=production
AUTOPE_DATABASE_URL=postgresql+psycopg://autope:change-me@localhost:5432/dify_autope
AUTOPE_ALLOWED_ORIGINS=https://autope.example.com
AUTOPE_AUTH_DISABLED=false
# Provide a random, deployment-specific value of at least 32 characters via Secret injection.
AUTOPE_SESSION_SECRET=replace-with-a-random-session-secret-of-at-least-32-characters
AUTOPE_SECRET_RESOLVER=external
# Read-only directory mounted by your secret manager; each secret_ref is a relative file path.
AUTOPE_EXTERNAL_SECRET_DIR=/var/run/secrets/autope
AUTOPE_WORKER_LEASE_SECONDS=180
AUTOPE_WORKER_HEARTBEAT_MAX_AGE_SECONDS=90
AUTOPE_REQUIRE_WORKER_HEARTBEAT=true
